@startuml SportPulse_UseCase
' Sursa PlantUML pentru Use Case Diagram (se poate randa pe https://www.plantuml.com/plantuml)
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #1F3A5F
}

actor "Vizitator" as V
actor "Utilizator înregistrat" as U
actor "Administrator" as A
actor "Planificator\n(timer sistem)" as T
actor "API-Sports\n(sistem extern)" as API <<system>>

U --|> V
A --|> U

rectangle "SportPulse" {
  usecase "UC1 Selectare sport" as UC1
  usecase "UC2 Vizualizare program meciuri (pe zile)" as UC2
  usecase "UC3 Urmărire scoruri live" as UC3
  usecase "UC4 Filtrare după țară / competiție" as UC4
  usecase "UC5 Vizualizare detalii meci" as UC5
  usecase "UC6 Comparare head-to-head" as UC6
  usecase "UC7 Vizualizare clasament" as UC7
  usecase "UC8 Vizualizare echipă și lot" as UC8
  usecase "UC9 Vizualizare profil jucător" as UC9
  usecase "UC10 Căutare echipe / jucători / competiții" as UC10
  usecase "UC11 Export meci în calendar (.ics)" as UC11
  usecase "UC12 Înregistrare cont" as UC12
  usecase "UC13 Autentificare" as UC13
  usecase "UC14 Gestionare favorite" as UC14
  usecase "UC15 Vizualizare „Meciurile mele”" as UC15
  usecase "UC16 Vizualizare meciuri recomandate (Interest Score)" as UC16
  usecase "UC17 Primire notificări (start, gol, final)" as UC17
  usecase "UC18 Configurare sporturi / competiții afișate" as UC18
  usecase "UC19 Monitorizare consum API" as UC19
  usecase "UC20 Sincronizare date sportive (cache)" as UC20
}

V --> UC1
V --> UC2
V --> UC3
V --> UC4
V --> UC5
V --> UC6
V --> UC7
V --> UC8
V --> UC9
V --> UC10
V --> UC11
V --> UC12

U --> UC13
U --> UC14
U --> UC15
U --> UC16
U --> UC17

A --> UC18
A --> UC19

T --> UC20
UC20 --> API

UC14 ..> UC13 : <<include>>
UC15 ..> UC14 : <<include>>
UC6 ..> UC5 : <<extend>>
@enduml
